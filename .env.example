# --- required ---
# Postgres connection string
DATABASE_URL="postgresql://postgres@localhost:5432/gebeta"
# At least 32 random characters. Generate with: openssl rand -base64 48
SESSION_SECRET=""
# Public address of the site, used inside QR codes (no trailing slash)
APP_URL="http://localhost:3000"

# --- optional: everything below switches on a feature when set ---
# Platform admins (comma-separated, +2519… format) can open /admin
ADMIN_PHONES=""
# Telegram bot from @BotFather: alerts, /price and /soldout commands, password reset
TELEGRAM_BOT_TOKEN=""
TELEGRAM_BOT_USERNAME=""   # without the @
TELEGRAM_WEBHOOK_SECRET="" # any random string; then press "Connect webhook" on /admin
ADMIN_TELEGRAM_CHAT_ID=""  # where server errors, plan payments and stand orders are reported
# Weekly summary: the GitHub workflow calls /api/cron/weekly with this secret
CRON_SECRET=""
# Accounts shown to owners paying for plans and stands by hand
PAY_TELEBIRR=""
PAY_CBE=""
# Chapa online checkout (Telebirr, CBE Birr, cards)
CHAPA_SECRET_KEY=""
